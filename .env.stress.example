POSTGRES_DB=goexchange
POSTGRES_USER=goexchange
POSTGRES_PASSWORD=change-me-postgres-password
# terraform apply 후 DB 인스턴스의 내부 IP로 교체할 것 (예: 10.10.0.x)
GOEXCHANGE_DB_HOST=change-me-db-instance-internal-ip
GOEXCHANGE_JWT_SECRET=change-me-to-a-long-random-secret
GOEXCHANGE_DEV_TOOLS_TOKEN=change-me-dev-tools-token
GOEXCHANGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
GOEXCHANGE_WS_ALLOWED_ORIGINS=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GOEXCHANGE_ENABLE_PPROF=true
GOEXCHANGE_DB_MAX_OPEN_CONNS=25
GOEXCHANGE_DB_MAX_IDLE_CONNS=25
GOEXCHANGE_DB_CONN_MAX_LIFETIME=30m
GOEXCHANGE_SETTLEMENT_WORKERS=10
GOEXCHANGE_SETTLEMENT_CONCURRENCY=4

# 설계 §2 — 서비스 HTTP 서버 시간 상한(기본값).
GOEXCHANGE_HTTP_READ_HEADER_TIMEOUT=5s
GOEXCHANGE_HTTP_READ_TIMEOUT=15s
GOEXCHANGE_HTTP_WRITE_TIMEOUT=20s
GOEXCHANGE_HTTP_IDLE_TIMEOUT=60s
GOEXCHANGE_HTTP_MAX_HEADER_BYTES=1048576

# 설계 §3 — 서비스 DB 풀 시간 상한(기본값).
GOEXCHANGE_DB_STATEMENT_TIMEOUT=15s
GOEXCHANGE_DB_LOCK_TIMEOUT=3s
GOEXCHANGE_DB_IDLE_TX_TIMEOUT=30s

# 설계 §7 — 관리 서버(/metrics·pprof). docker-compose.stress.yml이 이미
# 0.0.0.0:9101 기본값과 127.0.0.1:9101:9101 포워딩을 준다 — SSH 터널로만
# 접근한다(runbook 참고).
GOEXCHANGE_ADMIN_ADDR=0.0.0.0:9101
GOEXCHANGE_ADMIN_WRITE_TIMEOUT=120s

# 설계 §6.2·§6.4 — rate limit. 인증(login/register) 한도 400/200은
# loadtest/order-submission-stress.js의 SETUP_BATCH_SIZE(100)·
# SETUP_BATCH_INTERVAL_SECONDS(0.5s)에서 역산한 하니스 계약값이라(compose
# 기본값과 같다) 임의로 바꾸지 않는다. 주문·이체는 사용자당 2~5rps라 기본값과
# 충돌하지 않으므로 조정하지 않는다.
GOEXCHANGE_RATE_LIMIT_ENABLED=true
GOEXCHANGE_AUTH_RATE_LIMIT_RPS=400
GOEXCHANGE_AUTH_RATE_LIMIT_BURST=200
GOEXCHANGE_ORDER_RATE_LIMIT_RPS=20
GOEXCHANGE_ORDER_RATE_LIMIT_BURST=40
GOEXCHANGE_TRANSFER_RATE_LIMIT_RPS=2
GOEXCHANGE_TRANSFER_RATE_LIMIT_BURST=5

# 설계 §6.3 — 로드밸런서 없이 직접 노출하므로 보통 비운다.
GOEXCHANGE_TRUSTED_PROXIES=

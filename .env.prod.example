POSTGRES_DB=goexchange
POSTGRES_USER=goexchange
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

GOEXCHANGE_JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
GOEXCHANGE_ENABLE_DEV_TOOLS=false
GOEXCHANGE_DEV_TOOLS_TOKEN=
GOEXCHANGE_ENABLE_UPBIT=false

# EC2에 붙인 도메인이 있으면 도메인을 쓰고, 없으면 퍼블릭 IPv4 주소를 씁니다.
# 예: http://13.125.10.20 또는 https://exchange.example.com
GOEXCHANGE_PUBLIC_ORIGIN=http://CHANGE_ME_EC2_PUBLIC_IP
GOEXCHANGE_CORS_ALLOWED_ORIGINS=http://CHANGE_ME_EC2_PUBLIC_IP
GOEXCHANGE_WS_ALLOWED_ORIGINS=http://CHANGE_ME_EC2_PUBLIC_IP

BACKEND_IMAGE=ghcr.io/go-exchange-project/go-exchange-back:latest
FRONTEND_IMAGE=ghcr.io/go-exchange-project/go-exchange-front:latest
BACKEND_PORT=8080
FRONTEND_PORT=80

# 설계 §2 — 서비스 HTTP 서버 시간 상한(기본값). 배포 환경에서 조정이 필요하면
# 바꾼다.
GOEXCHANGE_HTTP_READ_HEADER_TIMEOUT=5s
GOEXCHANGE_HTTP_READ_TIMEOUT=15s
GOEXCHANGE_HTTP_WRITE_TIMEOUT=20s
GOEXCHANGE_HTTP_IDLE_TIMEOUT=60s
GOEXCHANGE_HTTP_MAX_HEADER_BYTES=1048576

# 설계 §3 — 서비스 DB 풀 시간 상한(기본값).
GOEXCHANGE_DB_STATEMENT_TIMEOUT=15s
GOEXCHANGE_DB_LOCK_TIMEOUT=3s
GOEXCHANGE_DB_IDLE_TX_TIMEOUT=30s

# 설계 §7 — 관리 서버(/metrics·pprof). 컨테이너에서는 0.0.0.0 바인드가 필요하다
# (docker-compose.prod.yml이 이미 이 기본값을 준다). 포트를 published하지
# 않으므로 호스트 밖에서는 접근할 수 없다.
GOEXCHANGE_ADMIN_ADDR=0.0.0.0:9101
GOEXCHANGE_ADMIN_WRITE_TIMEOUT=120s

# 설계 §6.2 — rate limit(기본값). 대상: login/register(IP), 주문 생성·취소·이체
# (사용자 ID). 끄면 운영 미들웨어 경로를 우회한 다른 시스템을 측정하게 되므로
# 권장하지 않는다.
GOEXCHANGE_RATE_LIMIT_ENABLED=true
GOEXCHANGE_AUTH_RATE_LIMIT_RPS=1
GOEXCHANGE_AUTH_RATE_LIMIT_BURST=10
GOEXCHANGE_ORDER_RATE_LIMIT_RPS=20
GOEXCHANGE_ORDER_RATE_LIMIT_BURST=40
GOEXCHANGE_TRANSFER_RATE_LIMIT_RPS=2
GOEXCHANGE_TRANSFER_RATE_LIMIT_BURST=5

# 설계 §6.3 — 리버스 프록시·로드밸런서 뒤에 있으면 그 CIDR을 콤마로 나열한다
# (예: 10.0.0.0/8). 비우면 X-Forwarded-For를 무시하고 RemoteAddr만 쓴다.
GOEXCHANGE_TRUSTED_PROXIES=
